# Only the README and the app source are published.
/*
!/.gitignore
!/README.md
!/app/

# build output
app/bin/
app/obj/
app/publish/

# test output (holds server addresses / device IDs)
app/shots/*
!app/shots/icon.png
!app/shots/home.png
!app/shots/home-dark.png
!app/shots/session.png
!app/shots/settings.png
!app/shots/recent.png
!app/shots/files.png
!app/shots/chat.png
!app/shots/toolbar.png
!app/shots/accept.png
!app/shots/password.png
!app/shots/progress.png
