<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Rplus</AssemblyName>
    <RootNamespace>Rplus</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>rplus.ico</ApplicationIcon>
    <Version>1.0.2</Version>
    <AssemblyTitle>Rplus</AssemblyTitle>
    <Product>Rplus</Product>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="rplus.ico" LogicalName="rplus.ico" />
  </ItemGroup>

</Project>
